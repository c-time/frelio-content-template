# 再利用可能ワークフロー（reusable / workflow_call）。
# develop → staging マージ → SSG ビルド → artifact → staging プレビュー →
# staging → main マージ → 本番デプロイ → デプロイタグ付与。
# direct-deploy.yml（手動）と scheduled-publish.yml（予約反映）の両方から呼ばれる。
name: Deploy (reusable)
on:
  workflow_call:
    inputs:
      full_rebuild:
        description: 'Full rebuild (skip cache, regenerate all)'
        required: false
        default: 'false'
        type: string

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0

      - name: Configure git
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"

      # Step 1: develop → staging マージ
      - name: Merge develop into staging
        run: |
          git checkout staging
          git merge origin/develop --no-edit
          git push origin staging

      # Step 2: SSG ビルド
      - uses: actions/setup-node@v6
        with:
          node-version: 24.22.1
          cache: 'npm'

      # 前回の staging ビルド状態を復元（差分ビルド用、全生成時はスキップ）
      - name: Restore SSG cache
        if: inputs.full_rebuild != 'true'
        uses: actions/cache@v5
        with:
          path: |
            frelio-data/site/data/data-json
            public
          key: ssg-cache-staging-${{ github.sha }}
          restore-keys: |
            ssg-cache-staging-

      # 全生成時: 既存の出力を削除してクリーンな状態から開始
      - name: Clear existing output for full rebuild
        if: inputs.full_rebuild == 'true'
        run: |
          rm -rf frelio-data/site/data/data-json
          rm -rf public

      # 環境ごとの生成物がキャッシュから戻って別環境に載らないよう消しておく。
      # sitemap.xml / robots.txt は本番専用（issue #354 #355）、_headers はプレビュー専用（noindex・CORS）。
      # 特に _headers が artifact に混ざると本番まで noindex になるため、ビルド前に必ず消す。
      - name: Remove per-environment files restored from cache
        run: rm -f public/sitemap.xml public/robots.txt public/_headers

      - run: npm ci

      # 依存マップを生成（データ生成の前提。scaffold 直後は未コミットのため CI で毎回生成する）
      - name: Generate dependency map
        run: npm run generate:dep-map

      # 初回ビルド（data-json 未生成）はキャッシュが空で、増分モードだと 0 件になり
      # 中身の無いサイトが本番化されてしまう。data-json が空なら full-rebuild にする。
      - name: Decide rebuild mode
        id: ssg
        run: |
          if [ "${{ inputs.full_rebuild }}" = "true" ] || [ -z "$(find frelio-data/site/data/data-json -name '*.json' -type f 2>/dev/null | head -1)" ]; then
            echo "full=true" >> "$GITHUB_OUTPUT"
          else
            echo "full=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Generate JSON data
        run: npx frelio-data-json-generator ${{ steps.ssg.outputs.full == 'true' && '--full-rebuild' || '' }}

      - name: Generate HTML
        run: npx frelio-gentl

      - name: Build assets
        run: npm run build

      # 機械チェック（issue #357）: validate（schema / content / templates）と bake:check を実行する。
      # 既定は警告（失敗してもデプロイは止めない）。admin/config.json に "buildChecks": "fail" を書くと
      # 失敗扱い（このジョブを失敗させ、プレビュー／本番へのデプロイを止める）。
      # 結果はジョブサマリー（Actions の実行画面）とアノテーションに出す。npm script が無い検査はスキップ。
      - name: Check content & templates (validate / bake:check)
        run: |
          MODE=$(jq -r '.buildChecks // "warn"' admin/config.json 2>/dev/null || echo warn)
          [ "$MODE" = "fail" ] || MODE=warn
          LEVEL=warning
          [ "$MODE" = "fail" ] && LEVEL=error
          FAILED=""
          {
            echo "## 機械チェック（validate / bake:check）"
            echo ""
            echo "モード: \`$MODE\`（admin/config.json の \`buildChecks\`。\`fail\` にすると失敗時にデプロイを止める）"
            echo ""
          } >> "$GITHUB_STEP_SUMMARY"
          for S in validate:schema validate:content validate:templates bake:check; do
            if [ "$(npm pkg get "scripts.$S")" = "{}" ]; then
              echo "- SKIP \`npm run $S\`（npm script が無い）" >> "$GITHUB_STEP_SUMMARY"
              continue
            fi
            LOG="/tmp/frelio-check-${S//:/-}.log"
            echo "::group::npm run $S"
            if npm run --silent "$S" > "$LOG" 2>&1; then
              cat "$LOG"
              echo "::endgroup::"
              echo "- OK \`npm run $S\`" >> "$GITHUB_STEP_SUMMARY"
            else
              cat "$LOG"
              echo "::endgroup::"
              FAILED="$FAILED $S"
              echo "::$LEVEL title=npm run $S が失敗::検査で問題が見つかりました。詳細はジョブサマリー（またはこのステップのログ）を参照してください"
              {
                echo "- **NG** \`npm run $S\`"
                echo ""
                echo "<details><summary>ログ（末尾 100 行）</summary>"
                echo ""
                echo '```text'
                tail -n 100 "$LOG"
                echo '```'
                echo ""
                echo "</details>"
              } >> "$GITHUB_STEP_SUMMARY"
            fi
          done
          if [ -n "$FAILED" ] && [ "$MODE" = "fail" ]; then
            echo "::error::機械チェックが失敗したためデプロイを止めます:${FAILED}（警告にとどめるには admin/config.json の buildChecks を外すか \"warn\" に）"
            exit 1
          fi

      # Step 3: artifact アップロード（本番昇格の高速化用・必須依存ではない）
      # このジョブは同じ public/ をそのまま本番デプロイしており、artifact を後続ステップから参照しない。
      # promote-production も欠損時はフル SSG ビルドへフォールバックするため、ここでの失敗
      # （Actions ストレージ枠超過など）でデプロイを道連れにしないよう continue-on-error にする（Issue #237）。
      - name: Upload artifact
        continue-on-error: true
        uses: actions/upload-artifact@v7
        with:
          name: staging-build
          path: public/
          retention-days: 5

      # プレビュー専用: 静的ページに X-Robots-Tag: noindex を付ける（issue #355）。
      # artifact アップロード後に書き、本番デプロイ前に消す（本番には載せない）。
      - name: Add noindex header (preview only)
        run: |
          cat > public/_headers <<'HEADERS'
          # プレビュー専用（_deploy が付与）。本番デプロイ前に削除する。
          /*
            X-Robots-Tag: noindex
          HEADERS

      # Step 4: Cloudflare Workers プレビューデプロイ（staging エイリアス / Issue #184）
      # コンテンツ Worker 未作成（本番デプロイ前）だと versions upload が失敗するため、
      # その場合だけ一度 deploy でブートストラップしてから preview を作る（issue #223-B）。
      - name: Deploy staging preview (bootstrap content worker if missing)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
        run: |
          set -o pipefail
          if npx wrangler versions upload --config wrangler.content.toml --preview-alias staging 2>&1 | tee /tmp/wrangler-preview.log; then
            exit 0
          fi
          if grep -q "does not yet exist" /tmp/wrangler-preview.log; then
            echo "::notice::Content worker not found — bootstrapping with an initial deploy (first run before production)"
            # bootstrap の deploy は本番バージョンになるため、プレビュー専用の _headers（noindex 等）を一時退避して載せない（issue #355）
            mv public/_headers "$RUNNER_TEMP/_headers.preview"
            npx wrangler deploy --config wrangler.content.toml
            mv "$RUNNER_TEMP/_headers.preview" public/_headers
            npx wrangler versions upload --config wrangler.content.toml --preview-alias staging
          else
            echo "::error::wrangler versions upload failed"
            exit 1
          fi

      # Step 5: staging → main マージ
      # main がマージコミット履歴を持つ運用でも確実に取り込めるよう、Step 1 と同じ
      # マージ方式に統一する（--ff-only は main 分岐時に失敗するため使わない）。
      - name: Merge staging into main
        # ビルド／wrangler-action の Wrangler 自動インストールで作業ツリーの追跡ファイル
        # (package.json / package-lock.json / 再生成された data-json 等) が変更され、
        # git checkout main を阻害する。生成物 public/ は gitignore 済み(untracked)のため、
        # 追跡ファイルの変更のみ破棄してから main へ切り替える。
        #
        # 本番ロールバック（rollback-production.yml・issue #371）の後は、main に「タグ時点へ戻す」コミット
        # （`Frelio-Rollback:` 行付き）が staging 取り込みより後に乗っている。そのまま 3-way マージすると
        # 戻した変更が戻ったまま残る／コンフリクトするため、そのときだけ main を staging の内容に揃える
        # （親は main と staging の 2 つ。履歴は書き換えない）。それ以外は従来どおりの通常マージ。
        run: |
          git checkout -- .
          git checkout main
          ROLLBACK_PENDING=false
          for C in $(git rev-list --first-parent staging..main); do
            # 直近の staging 取り込み（マージコミット）より前は見ない
            [ "$(git rev-list --no-walk --parents "$C" | wc -w)" -gt 2 ] && break
            if git log -1 --format=%B "$C" | grep -q '^Frelio-Rollback:'; then ROLLBACK_PENDING=true; break; fi
          done
          if [ "$ROLLBACK_PENDING" = true ]; then
            echo "::notice::本番ロールバック後のため、main を staging の内容に揃えてから本番化します"
            SYNCED=$(git commit-tree "staging^{tree}" -p HEAD -p staging -m "Merge staging into main (本番ロールバック後: main を staging の内容に揃える)")
            git reset -q --hard "$SYNCED"
          else
            git merge staging --no-edit
          fi
          git push origin main

      # プレビュー専用の public/_headers（X-Robots-Tag: noindex・CORS）を本番に載せない（issue #355）
      - name: Remove preview-only headers (production)
        run: rm -f public/_headers

      # 本番向けのみ: sitemap.xml を生成して public/ に含める（issue #354）。staging プレビューには出さない。
      # 基準 URL は admin/config.json の productionUrl（SITE_BASE_URL で渡す。旧版のスクリプトも解釈できる）。
      # productionUrl 未設定、またはスクリプト / npm script が無い（frelio update でスクリプトを上げていない
      # 既存サイト）ときはスキップする。生成に失敗してもデプロイは止めない（sitemap 無しで公開されるだけ）。
      - name: Generate sitemap.xml (production only)
        continue-on-error: true
        run: |
          BASE_URL=$(jq -r '.productionUrl // ""' admin/config.json 2>/dev/null || true)
          if [ -z "$BASE_URL" ]; then
            echo "::warning::admin/config.json の productionUrl が未設定のため sitemap.xml を生成しません"
            exit 0
          fi
          if [ ! -f scripts/generate-sitemap.ts ] || [ "$(npm pkg get 'scripts.generate:sitemap')" = "{}" ]; then
            echo "::notice::scripts/generate-sitemap.ts（npm run generate:sitemap）が無いため sitemap.xml の生成をスキップします"
            exit 0
          fi
          [ -x node_modules/.bin/tsx ] || npm ci
          SITE_BASE_URL="$BASE_URL" npm run generate:sitemap

      # 本番向けのみ: robots.txt を生成（issue #355）。frelio-data/site/templates/robots.txt があればそれを優先し、
      # 無ければ全クロール許可＋Sitemap 行（sitemap.xml がある場合）を出す。スクリプトが無いサイトはスキップ。
      - name: Generate robots.txt (production only)
        continue-on-error: true
        run: |
          if [ ! -f scripts/generate-robots.ts ] || [ "$(npm pkg get 'scripts.generate:robots')" = "{}" ]; then
            echo "::notice::scripts/generate-robots.ts（npm run generate:robots）が無いため robots.txt の生成をスキップします"
            exit 0
          fi
          [ -x node_modules/.bin/tsx ] || npm ci
          SITE_BASE_URL="$(jq -r '.productionUrl // ""' admin/config.json 2>/dev/null || true)" npm run generate:robots

      # Step 6: Cloudflare Workers 本番デプロイ（Issue #184: Static Assets）
      - name: Deploy to production
        uses: cloudflare/wrangler-action@v4
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: deploy --config wrangler.content.toml

      # Step 7: デプロイタグ作成
      - name: Create deploy tag
        run: |
          VERSION=$(jq -r '.version' version.json 2>/dev/null || echo "0.0.0")
          PREFIX="d${VERSION}."
          LATEST=$(git tag -l "${PREFIX}*" | sed "s/^${PREFIX}//" | sort -n | tail -1)
          NEXT=$(( ${LATEST:-0} + 1 ))
          TAG="${PREFIX}${NEXT}"

          git tag -a "$TAG" -m "Deploy $TAG"
          git push origin "$TAG"
          echo "::notice::Tagged as $TAG"
