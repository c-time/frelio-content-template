# 再利用可能ワークフロー（reusable / workflow_call）。
# develop → staging マージ → SSG ビルド → artifact → staging プレビュー →
# staging → main マージ → 本番デプロイ → デプロイタグ付与。
# direct-deploy.yml（手動）と scheduled-publish.yml（予約反映）の両方から呼ばれる。
name: Deploy (reusable)
on:
  workflow_call:
    inputs:
      full_rebuild:
        description: 'Full rebuild (skip cache, regenerate all)'
        required: false
        default: 'false'
        type: string

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0

      - name: Configure git
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"

      # Step 1: develop → staging マージ
      - name: Merge develop into staging
        run: |
          git checkout staging
          git merge origin/develop --no-edit
          git push origin staging

      # Step 2: SSG ビルド
      - uses: actions/setup-node@v6
        with:
          node-version: 24
          cache: 'npm'

      # 前回の staging ビルド状態を復元（差分ビルド用、全生成時はスキップ）
      - name: Restore SSG cache
        if: inputs.full_rebuild != 'true'
        uses: actions/cache@v5
        with:
          path: |
            frelio-data/site/data/data-json
            public
          key: ssg-cache-staging-${{ github.sha }}
          restore-keys: |
            ssg-cache-staging-

      # 全生成時: 既存の出力を削除してクリーンな状態から開始
      - name: Clear existing output for full rebuild
        if: inputs.full_rebuild == 'true'
        run: |
          rm -rf frelio-data/site/data/data-json
          rm -rf public

      - run: npm ci

      # 依存マップを生成（データ生成の前提。scaffold 直後は未コミットのため CI で毎回生成する）
      - name: Generate dependency map
        run: npm run generate:dep-map

      # 初回ビルド（data-json 未生成）はキャッシュが空で、増分モードだと 0 件になり
      # 中身の無いサイトが本番化されてしまう。data-json が空なら full-rebuild にする。
      - name: Decide rebuild mode
        id: ssg
        run: |
          if [ "${{ inputs.full_rebuild }}" = "true" ] || [ -z "$(find frelio-data/site/data/data-json -name '*.json' -type f 2>/dev/null | head -1)" ]; then
            echo "full=true" >> "$GITHUB_OUTPUT"
          else
            echo "full=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Generate JSON data
        run: npx frelio-data-json-generator ${{ steps.ssg.outputs.full == 'true' && '--full-rebuild' || '' }}

      - name: Generate HTML
        run: npx frelio-gentl

      - name: Build assets
        run: npm run build

      # Step 3: artifact アップロード（本番昇格の高速化用・必須依存ではない）
      # このジョブは同じ public/ をそのまま本番デプロイしており、artifact を後続ステップから参照しない。
      # promote-production も欠損時はフル SSG ビルドへフォールバックするため、ここでの失敗
      # （Actions ストレージ枠超過など）でデプロイを道連れにしないよう continue-on-error にする（Issue #237）。
      - name: Upload artifact
        continue-on-error: true
        uses: actions/upload-artifact@v7
        with:
          name: staging-build
          path: public/
          retention-days: 5

      # Step 4: Cloudflare Workers プレビューデプロイ（staging エイリアス / Issue #184）
      # コンテンツ Worker 未作成（本番デプロイ前）だと versions upload が失敗するため、
      # その場合だけ一度 deploy でブートストラップしてから preview を作る（issue #223-B）。
      - name: Deploy staging preview (bootstrap content worker if missing)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
        run: |
          set -o pipefail
          if npx wrangler versions upload --config wrangler.content.toml --preview-alias staging 2>&1 | tee /tmp/wrangler-preview.log; then
            exit 0
          fi
          if grep -q "does not yet exist" /tmp/wrangler-preview.log; then
            echo "::notice::Content worker not found — bootstrapping with an initial deploy (first run before production)"
            npx wrangler deploy --config wrangler.content.toml
            npx wrangler versions upload --config wrangler.content.toml --preview-alias staging
          else
            echo "::error::wrangler versions upload failed"
            exit 1
          fi

      # Step 5: staging → main マージ
      # main がマージコミット履歴を持つ運用でも確実に取り込めるよう、Step 1 と同じ
      # マージ方式に統一する（--ff-only は main 分岐時に失敗するため使わない）。
      - name: Merge staging into main
        # ビルド／wrangler-action の Wrangler 自動インストールで作業ツリーの追跡ファイル
        # (package.json / package-lock.json / 再生成された data-json 等) が変更され、
        # git checkout main を阻害する。生成物 public/ は gitignore 済み(untracked)のため、
        # 追跡ファイルの変更のみ破棄してから main へ切り替える。
        run: |
          git checkout -- .
          git checkout main
          git merge staging --no-edit
          git push origin main

      # Step 6: Cloudflare Workers 本番デプロイ（Issue #184: Static Assets）
      - name: Deploy to production
        uses: cloudflare/wrangler-action@v4
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: deploy --config wrangler.content.toml

      # Step 7: デプロイタグ作成
      - name: Create deploy tag
        run: |
          VERSION=$(jq -r '.version' version.json 2>/dev/null || echo "0.0.0")
          PREFIX="d${VERSION}."
          LATEST=$(git tag -l "${PREFIX}*" | sed "s/^${PREFIX}//" | sort -n | tail -1)
          NEXT=$(( ${LATEST:-0} + 1 ))
          TAG="${PREFIX}${NEXT}"

          git tag -a "$TAG" -m "Deploy $TAG"
          git push origin "$TAG"
          echo "::notice::Tagged as $TAG"
