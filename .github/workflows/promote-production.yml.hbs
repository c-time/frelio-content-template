# staging → main マージ（push to main）で発火。
# 最新の staging artifact をダウンロードし、Pages 本番にデプロイする。
# artifact 欠損時はフォールバックとしてフル SSG ビルドを実行する。
name: Promote to Production
on:
  push:
    branches: [main]

permissions:
  contents: write
  actions: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0

      # 最新の成功した Build Staging ワークフロー run を検索
      - name: Find latest staging build run
        id: find-run
        uses: actions/github-script@v9
        with:
          script: |
            const runs = await github.rest.actions.listWorkflowRuns({
              owner: context.repo.owner,
              repo: context.repo.repo,
              workflow_id: 'build-staging.yml',
              branch: 'staging',
              status: 'success',
              per_page: 1,
            });
            if (runs.data.workflow_runs.length > 0) {
              core.setOutput('run-id', runs.data.workflow_runs[0].id);
            } else {
              core.setOutput('run-id', '');
            }

      # cross-workflow artifact ダウンロード
      - name: Download staging artifact
        id: download-artifact
        if: steps.find-run.outputs.run-id != ''
        continue-on-error: true
        uses: actions/download-artifact@v8
        with:
          name: staging-build
          path: public/
          github-token: ${{ secrets.GITHUB_TOKEN }}
          run-id: ${{ steps.find-run.outputs.run-id }}

      # artifact 取得結果を判定
      - name: Check if artifact was downloaded
        id: check-artifact
        run: |
          if [ -d "public" ] && [ "$(ls -A public 2>/dev/null)" ]; then
            echo "has_artifact=true" >> "$GITHUB_OUTPUT"
          else
            echo "::warning::Staging artifact not found or expired. Running full SSG build."
            echo "has_artifact=false" >> "$GITHUB_OUTPUT"
          fi

      # --- フォールバックビルド（artifact 欠損時のみ） ---
      - name: Setup Node.js (fallback)
        if: steps.check-artifact.outputs.has_artifact == 'false'
        uses: actions/setup-node@v6
        with:
          node-version: 24.22.1
          cache: 'npm'

      - name: Install dependencies (fallback)
        if: steps.check-artifact.outputs.has_artifact == 'false'
        run: npm ci

      - name: Full SSG build (fallback)
        if: steps.check-artifact.outputs.has_artifact == 'false'
        run: |
          npm run generate:dep-map
          npx frelio-data-json-generator --full-rebuild
          npx frelio-gentl
          npm run build

      # sitemap 生成用の Node.js（artifact 利用時はフォールバックの setup が走らないため）
      - name: Setup Node.js (sitemap)
        if: steps.check-artifact.outputs.has_artifact == 'true'
        uses: actions/setup-node@v6
        with:
          node-version: 24.22.1
          cache: 'npm'

      # プレビュー専用の public/_headers（X-Robots-Tag: noindex・CORS）を本番に載せない（issue #355）
      - name: Remove preview-only headers (production)
        run: rm -f public/_headers

      # 本番向けのみ: sitemap.xml を生成して public/ に含める（issue #354）。staging プレビューには出さない。
      # 基準 URL は admin/config.json の productionUrl（SITE_BASE_URL で渡す。旧版のスクリプトも解釈できる）。
      # productionUrl 未設定、またはスクリプト / npm script が無い（frelio update でスクリプトを上げていない
      # 既存サイト）ときはスキップする。生成に失敗してもデプロイは止めない（sitemap 無しで公開されるだけ）。
      - name: Generate sitemap.xml (production only)
        continue-on-error: true
        run: |
          BASE_URL=$(jq -r '.productionUrl // ""' admin/config.json 2>/dev/null || true)
          if [ -z "$BASE_URL" ]; then
            echo "::warning::admin/config.json の productionUrl が未設定のため sitemap.xml を生成しません"
            exit 0
          fi
          if [ ! -f scripts/generate-sitemap.ts ] || [ "$(npm pkg get 'scripts.generate:sitemap')" = "{}" ]; then
            echo "::notice::scripts/generate-sitemap.ts（npm run generate:sitemap）が無いため sitemap.xml の生成をスキップします"
            exit 0
          fi
          [ -x node_modules/.bin/tsx ] || npm ci
          SITE_BASE_URL="$BASE_URL" npm run generate:sitemap

      # 本番向けのみ: robots.txt を生成（issue #355）。frelio-data/site/templates/robots.txt があればそれを優先し、
      # 無ければ全クロール許可＋Sitemap 行（sitemap.xml がある場合）を出す。スクリプトが無いサイトはスキップ。
      - name: Generate robots.txt (production only)
        continue-on-error: true
        run: |
          if [ ! -f scripts/generate-robots.ts ] || [ "$(npm pkg get 'scripts.generate:robots')" = "{}" ]; then
            echo "::notice::scripts/generate-robots.ts（npm run generate:robots）が無いため robots.txt の生成をスキップします"
            exit 0
          fi
          [ -x node_modules/.bin/tsx ] || npm ci
          SITE_BASE_URL="$(jq -r '.productionUrl // ""' admin/config.json 2>/dev/null || true)" npm run generate:robots

      # Cloudflare Workers 本番にデプロイ（Issue #184: Static Assets）
      # wrangler deploy が worker/index.ts + [assets](./public) を本番（独自ドメイン）へ反映する。
      - name: Deploy to production
        uses: cloudflare/wrangler-action@v4
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: deploy --config wrangler.content.toml

      # デプロイタグ作成
      - name: Create deploy tag
        run: |
          VERSION=$(jq -r '.version' version.json 2>/dev/null || echo "0.0.0")
          PREFIX="d${VERSION}."

          LATEST=$(git tag -l "${PREFIX}*" | sed "s/^${PREFIX}//" | sort -n | tail -1)
          NEXT=$(( ${LATEST:-0} + 1 ))

          TAG="${PREFIX}${NEXT}"
          echo "Creating tag: $TAG"

          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git tag -a "$TAG" -m "Production deploy $TAG"
          git push origin "$TAG"

          echo "::notice::Tagged as $TAG"
