# staging ブランチ（デフォルト + 個人プレビュー）への push で発火し、SSG を実行する。
# 個人プレビュー（staging-*）は artifact アップロードなし（プレビュー専用）。
# workflow_dispatch で full_rebuild=true を指定すると、キャッシュを無視して全生成する。
name: Build Staging
on:
  push:
    branches: [staging, 'staging-*']
  workflow_dispatch:
    inputs:
      full_rebuild:
        description: 'Full rebuild (skip cache, regenerate all)'
        required: false
        default: 'false'
        type: choice
        options: ['false', 'true']

concurrency:
  group: build-staging-${{ github.ref_name }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    outputs:
      preview_url: ${{ steps.preview.outputs.url }}
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v6
        with:
          node-version: 24.22.1
          cache: 'npm'

      # 前回のビルド状態を復元（差分ビルド用、全生成時はスキップ）
      - name: Restore SSG cache
        if: inputs.full_rebuild != 'true'
        uses: actions/cache@v5
        with:
          path: |
            frelio-data/site/data/data-json
            public
          key: ssg-cache-${{ github.ref_name }}-${{ github.sha }}
          restore-keys: |
            ssg-cache-${{ github.ref_name }}-

      # 全生成時: 既存の出力を削除してクリーンな状態から開始
      - name: Clear existing output for full rebuild
        if: inputs.full_rebuild == 'true'
        run: |
          rm -rf frelio-data/site/data/data-json
          rm -rf public

      # 環境ごとの生成物がキャッシュから戻って別環境に載らないよう消しておく。
      # sitemap.xml / robots.txt は本番専用（issue #354 #355）、_headers はプレビュー専用（noindex・CORS）。
      # 特に _headers が artifact に混ざると本番まで noindex になるため、ビルド前に必ず消す。
      - name: Remove per-environment files restored from cache
        run: rm -f public/sitemap.xml public/robots.txt public/_headers

      - run: npm ci

      # 依存マップを生成（データ生成の前提。scaffold 直後は未コミットのため CI で毎回生成する）
      - name: Generate dependency map
        run: npm run generate:dep-map

      # 初回ビルド（data-json 未生成）はキャッシュが空で、増分モードだと 0 件になり
      # 中身の無いサイトがデプロイされてしまう。data-json が空なら full-rebuild にする。
      - name: Decide rebuild mode
        id: ssg
        run: |
          if [ "${{ inputs.full_rebuild }}" = "true" ] || [ -z "$(find frelio-data/site/data/data-json -name '*.json' -type f 2>/dev/null | head -1)" ]; then
            echo "full=true" >> "$GITHUB_OUTPUT"
          else
            echo "full=false" >> "$GITHUB_OUTPUT"
          fi

      # Phase 1: JSON 中間データ生成
      - name: Generate JSON data
        run: npx frelio-data-json-generator ${{ steps.ssg.outputs.full == 'true' && '--full-rebuild' || '' }}

      # Phase 2: HTML 生成
      - name: Generate HTML
        run: npx frelio-gentl

      # Phase 3: アセットビルド（静的アセットコピー + Vite）
      - name: Build assets
        run: npm run build

      # 機械チェック（issue #357）: validate（schema / content / templates）と bake:check を実行する。
      # 既定は警告（失敗してもデプロイは止めない）。admin/config.json に "buildChecks": "fail" を書くと
      # 失敗扱い（このジョブを失敗させ、プレビュー／本番へのデプロイを止める）。
      # 結果はジョブサマリー（Actions の実行画面）とアノテーションに出す。npm script が無い検査はスキップ。
      - name: Check content & templates (validate / bake:check)
        run: |
          MODE=$(jq -r '.buildChecks // "warn"' admin/config.json 2>/dev/null || echo warn)
          [ "$MODE" = "fail" ] || MODE=warn
          LEVEL=warning
          [ "$MODE" = "fail" ] && LEVEL=error
          FAILED=""
          {
            echo "## 機械チェック（validate / bake:check）"
            echo ""
            echo "モード: \`$MODE\`（admin/config.json の \`buildChecks\`。\`fail\` にすると失敗時にデプロイを止める）"
            echo ""
          } >> "$GITHUB_STEP_SUMMARY"
          for S in validate:schema validate:content validate:templates bake:check; do
            if [ "$(npm pkg get "scripts.$S")" = "{}" ]; then
              echo "- SKIP \`npm run $S\`（npm script が無い）" >> "$GITHUB_STEP_SUMMARY"
              continue
            fi
            LOG="/tmp/frelio-check-${S//:/-}.log"
            echo "::group::npm run $S"
            if npm run --silent "$S" > "$LOG" 2>&1; then
              cat "$LOG"
              echo "::endgroup::"
              echo "- OK \`npm run $S\`" >> "$GITHUB_STEP_SUMMARY"
            else
              cat "$LOG"
              echo "::endgroup::"
              FAILED="$FAILED $S"
              echo "::$LEVEL title=npm run $S が失敗::検査で問題が見つかりました。詳細はジョブサマリー（またはこのステップのログ）を参照してください"
              {
                echo "- **NG** \`npm run $S\`"
                echo ""
                echo "<details><summary>ログ（末尾 100 行）</summary>"
                echo ""
                echo '```text'
                tail -n 100 "$LOG"
                echo '```'
                echo ""
                echo "</details>"
              } >> "$GITHUB_STEP_SUMMARY"
            fi
          done
          if [ -n "$FAILED" ] && [ "$MODE" = "fail" ]; then
            echo "::error::機械チェックが失敗したためデプロイを止めます:${FAILED}（警告にとどめるには admin/config.json の buildChecks を外すか \"warn\" に）"
            exit 1
          fi

      # デフォルト staging のみ: artifact をアップロード（本番昇格の高速化用・必須依存ではない）
      # promote-production は artifact 欠損時にフル SSG ビルドへフォールバックするため、
      # ここでの失敗（Actions ストレージ枠超過など）でデプロイを道連れにしないよう continue-on-error にする。
      # ステップは「失敗」として残りジョブは成功扱いになるので Actions 画面で異常には気付ける（Issue #237）。
      - name: Upload artifact
        if: github.ref == 'refs/heads/staging'
        continue-on-error: true
        uses: actions/upload-artifact@v7
        with:
          name: staging-build
          path: public/
          retention-days: 5

      # 公開ファイル数・総サイズを集計して public/_build-stats.json に出力（プレビュー限定）。
      # CMS のテンプレート編集画面で Cloudflare 無料枠（1バージョン20,000ファイル）の使用状況を表示する（issue #277）。
      # ★ artifact アップロード後に書くのが要点:
      #   promote-production は staging artifact をそのまま本番化するため、artifact に含めなければ
      #   本番(public/)にはこのファイルが出力されない。CMS は CORS 済みの staging プレビューから取得する。
      - name: Write build stats (preview only)
        run: |
          echo '{}' > public/_build-stats.json   # 自身も集計対象に含めるため先に作成
          COUNT=$(find public -type f | wc -l | tr -d ' ')
          BYTES=$(find public -type f -printf '%s\n' | awk '{s+=$1} END {print s+0}')
          printf '{"fileCount":%s,"totalBytes":%s,"builtAt":"%s","commit":"%s"}\n' \
            "$COUNT" "$BYTES" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${GITHUB_SHA:-}" > public/_build-stats.json
          echo "::notice::build stats — files=$COUNT bytes=$BYTES"

      # プレビュー限定で CORS を付与する（本番には付けない）。
      # CMS のテンプレートビジュアルエディタは、別オリジンの管理画面から staging プレビューの
      # アセット（type="module" スクリプト等）をクロスオリジンで読み込むため CORS が必要。
      # ★ artifact アップロード後・preview デプロイ前に書くのが要点:
      #   promote-production は staging artifact をそのまま本番化するため、artifact に含めると
      #   本番にも CORS が乗ってしまう。ここで書けば本番は素の静的配信（無料・CORS なし）を維持する。
      - name: Add CORS for CMS visual editor (preview only)
        run: |
          cat > public/_headers <<'HEADERS'
          # プレビュー専用（build-staging が付与）。本番(promote-production)には含まれない。
          # X-Robots-Tag: プレビューを検索エンジンに載せない（issue #355。Worker 非経由の静的ページ用）。
          /*
            Access-Control-Allow-Origin: *
            X-Robots-Tag: noindex
          HEADERS

      # GitHub Actions から wrangler でプレビューデプロイ（Issue #184: Workers Static Assets）
      # versions upload はプレビュー版を作成し本番へは昇格しない。--preview-alias でブランチ別の
      # 安定エイリアス <branch>-{{contentWorkerName}}.<subdomain>.workers.dev を得る。
      #
      # コンテンツ Worker は本番デプロイ（promote-production の `wrangler deploy`）で初めて作成される。
      # 本番を一度も出す前に staging プレビューを試すと Worker 不在で versions upload が失敗するため、
      # その場合だけ一度 `deploy` してブートストラップしてから preview を作る（issue #223-B）。
      - name: Deploy preview (bootstrap content worker if missing)
        id: preview
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          PREVIEW_ALIAS: ${{ github.ref_name }}
        run: |
          set -o pipefail
          # 実際に払い出されたプレビューエイリアス URL を wrangler の出力から拾う（後段のバックフィル用）。
          # 取れなくてもデプロイは成功扱いのまま（バックフィルだけスキップ）。
          emit_preview_url() {
            URL=$(grep -oE "https://${PREVIEW_ALIAS}-[A-Za-z0-9-]+\.[A-Za-z0-9-]+\.workers\.dev" /tmp/wrangler-preview.log | tail -1 || true)
            if [ -n "$URL" ]; then
              echo "url=$URL" >> "$GITHUB_OUTPUT"
              echo "::notice::preview URL — $URL"
            fi
          }
          if npx wrangler versions upload --config wrangler.content.toml --preview-alias "$PREVIEW_ALIAS" 2>&1 | tee /tmp/wrangler-preview.log; then
            emit_preview_url
            exit 0
          fi
          if grep -q "does not yet exist" /tmp/wrangler-preview.log; then
            echo "::notice::Content worker not found — bootstrapping with an initial deploy (first run before production)"
            npx wrangler deploy --config wrangler.content.toml
            npx wrangler versions upload --config wrangler.content.toml --preview-alias "$PREVIEW_ALIAS" 2>&1 | tee /tmp/wrangler-preview.log
            emit_preview_url
          else
            echo "::error::wrangler versions upload failed"
            exit 1
          fi

  # 管理画面のテンプレートプレビュー用ベース URL を、実際に配信された staging URL で補完する（Issue #323）。
  # init 時点では staging の URL が未確定で templatePreviewBaseUrl が空のまま残ることがあり、
  # その状態だとビジュアルエディタが CSS を読み込めず無スタイルになる。管理画面は設定を
  # develop の admin/config.json から読むため、ここで develop へ書き戻す。
  # - 共有 staging のデプロイが成功し、URL を取得できたときだけ動く（個人プレビューは対象外）。
  # - 既に値が入っていれば上書きしない（手で設定した値・Basic 認証付き URL を壊さない）。
  #   実 URL と食い違うときは通知だけ出す（独自ドメインを意図して設定している場合もあるため）。
  # - 失敗してもビルド結果には影響させない（develop が保護ブランチで push できない場合など）。
  backfill-preview-base-url:
    needs: build
    if: github.ref == 'refs/heads/staging' && needs.build.outputs.preview_url != ''
    runs-on: ubuntu-latest
    continue-on-error: true
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v6
        with:
          ref: develop
      - name: Backfill templatePreviewBaseUrl
        env:
          PREVIEW_URL: ${{ needs.build.outputs.preview_url }}
        run: |
          if [ ! -f admin/config.json ]; then
            echo "::notice::admin/config.json が無いためスキップ"
            exit 0
          fi
          node <<'NODE'
          const fs = require('node:fs')
          const file = 'admin/config.json'
          const url = process.env.PREVIEW_URL
          const raw = fs.readFileSync(file, 'utf8')
          const config = JSON.parse(raw)
          const current = (config.templatePreviewBaseUrl || '').trim()
          if (current) {
            // 認証情報（user:pass@）の有無は無視して比べる
            const strip = (value) => value.replace(/^(https?:\/\/)[^@/]*@/, '$1').replace(/\/+$/, '')
            if (strip(current) !== url) {
              console.log('::notice::admin/config.json の templatePreviewBaseUrl（' + strip(current) + '）は、今回の staging プレビュー URL（' + url + '）と異なります。独自ドメイン等を意図して設定している場合は問題ありません。ビジュアルエディタが無スタイルになる場合は、管理画面の「基本設定」で見直してください。')
            }
            process.exit(0)
          }
          config.templatePreviewBaseUrl = url
          const indent = (raw.match(/^[ \t]+(?=")/m) || ['  '])[0]
          fs.writeFileSync(file, JSON.stringify(config, null, indent) + (raw.endsWith('\n') ? '\n' : ''))
          console.log('::notice::templatePreviewBaseUrl を ' + url + ' で補完しました')
          NODE
          if [ -z "$(git status --porcelain admin/config.json)" ]; then
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add admin/config.json
          git commit -m "chore(config): templatePreviewBaseUrl を staging プレビュー URL で補完"
          # 管理画面からのコミットと競合したら取り込み直して再試行する
          git push origin develop || (git pull --rebase origin develop && git push origin develop)
