# staging ブランチ（デフォルト + カスタム）への push で発火し、SSG を実行する。
# カスタム staging（staging-*）は artifact アップロードなし（プレビュー専用）。
# workflow_dispatch で full_rebuild=true を指定すると、キャッシュを無視して全生成する。
name: Build Staging
on:
  push:
    branches: [staging, 'staging-*']
  workflow_dispatch:
    inputs:
      full_rebuild:
        description: 'Full rebuild (skip cache, regenerate all)'
        required: false
        default: 'false'
        type: choice
        options: ['false', 'true']

concurrency:
  group: build-staging-${{ github.ref_name }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v6
        with:
          node-version: 24
          cache: 'npm'

      # 前回のビルド状態を復元（差分ビルド用、全生成時はスキップ）
      - name: Restore SSG cache
        if: inputs.full_rebuild != 'true'
        uses: actions/cache@v5
        with:
          path: |
            frelio-data/site/data/data-json
            public
          key: ssg-cache-${{ github.ref_name }}-${{ github.sha }}
          restore-keys: |
            ssg-cache-${{ github.ref_name }}-

      # 全生成時: 既存の出力を削除してクリーンな状態から開始
      - name: Clear existing output for full rebuild
        if: inputs.full_rebuild == 'true'
        run: |
          rm -rf frelio-data/site/data/data-json
          rm -rf public

      - run: npm ci

      # 依存マップを生成（データ生成の前提。scaffold 直後は未コミットのため CI で毎回生成する）
      - name: Generate dependency map
        run: npm run generate:dep-map

      # 初回ビルド（data-json 未生成）はキャッシュが空で、増分モードだと 0 件になり
      # 中身の無いサイトがデプロイされてしまう。data-json が空なら full-rebuild にする。
      - name: Decide rebuild mode
        id: ssg
        run: |
          if [ "${{ inputs.full_rebuild }}" = "true" ] || [ -z "$(find frelio-data/site/data/data-json -name '*.json' -type f 2>/dev/null | head -1)" ]; then
            echo "full=true" >> "$GITHUB_OUTPUT"
          else
            echo "full=false" >> "$GITHUB_OUTPUT"
          fi

      # Phase 1: JSON 中間データ生成
      - name: Generate JSON data
        run: npx frelio-data-json-generator ${{ steps.ssg.outputs.full == 'true' && '--full-rebuild' || '' }}

      # Phase 2: HTML 生成
      - name: Generate HTML
        run: npx frelio-gentl

      # Phase 3: アセットビルド（静的アセットコピー + Vite）
      - name: Build assets
        run: npm run build

      # デフォルト staging のみ: artifact をアップロード（本番昇格の高速化用・必須依存ではない）
      # promote-production は artifact 欠損時にフル SSG ビルドへフォールバックするため、
      # ここでの失敗（Actions ストレージ枠超過など）でデプロイを道連れにしないよう continue-on-error にする。
      # ステップは「失敗」として残りジョブは成功扱いになるので Actions 画面で異常には気付ける（Issue #237）。
      - name: Upload artifact
        if: github.ref == 'refs/heads/staging'
        continue-on-error: true
        uses: actions/upload-artifact@v7
        with:
          name: staging-build
          path: public/
          retention-days: 5

      # プレビュー限定で CORS を付与する（本番には付けない）。
      # CMS のテンプレートビジュアルエディタは、別オリジンの管理画面から staging プレビューの
      # アセット（type="module" スクリプト等）をクロスオリジンで読み込むため CORS が必要。
      # ★ artifact アップロード後・preview デプロイ前に書くのが要点:
      #   promote-production は staging artifact をそのまま本番化するため、artifact に含めると
      #   本番にも CORS が乗ってしまう。ここで書けば本番は素の静的配信（無料・CORS なし）を維持する。
      - name: Add CORS for CMS visual editor (preview only)
        run: |
          cat > public/_headers <<'HEADERS'
          # プレビュー専用（build-staging が付与）。本番(promote-production)には含まれない。
          /*
            Access-Control-Allow-Origin: *
          HEADERS

      # GitHub Actions から wrangler でプレビューデプロイ（Issue #184: Workers Static Assets）
      # versions upload はプレビュー版を作成し本番へは昇格しない。--preview-alias でブランチ別の
      # 安定エイリアス <branch>-{{contentWorkerName}}.<subdomain>.workers.dev を得る。
      #
      # コンテンツ Worker は本番デプロイ（promote-production の `wrangler deploy`）で初めて作成される。
      # 本番を一度も出す前に staging プレビューを試すと Worker 不在で versions upload が失敗するため、
      # その場合だけ一度 `deploy` してブートストラップしてから preview を作る（issue #223-B）。
      - name: Deploy preview (bootstrap content worker if missing)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          PREVIEW_ALIAS: ${{ github.ref_name }}
        run: |
          set -o pipefail
          if npx wrangler versions upload --config wrangler.content.toml --preview-alias "$PREVIEW_ALIAS" 2>&1 | tee /tmp/wrangler-preview.log; then
            exit 0
          fi
          if grep -q "does not yet exist" /tmp/wrangler-preview.log; then
            echo "::notice::Content worker not found — bootstrapping with an initial deploy (first run before production)"
            npx wrangler deploy --config wrangler.content.toml
            npx wrangler versions upload --config wrangler.content.toml --preview-alias "$PREVIEW_ALIAS"
          else
            echo "::error::wrangler versions upload failed"
            exit 1
          fi
