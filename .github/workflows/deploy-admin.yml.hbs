# 管理画面（CMS Admin）のデプロイ運用について（重要）
# - このワークフローは `admin` ブランチへの push でのみ発火し、管理画面をデプロイする。
# - `npx @c-time/frelio-cli update` で admin バンドル / Functions / Workers を更新しても、
#   develop 等のメインブランチへコミット/マージしただけでは管理画面に反映されない。
#   反映するには `admin` ブランチを最新へ進めて push する必要がある。
# - 反映方法（fast-forward push の例。develop は各プロジェクトのメインブランチ名に読み替える）:
#       git push origin origin/develop:admin
# - 詳細は AGENTS.md の「ブランチモデル / ブランチルール」を参照。
name: Deploy Admin
on:
  push:
    branches: [admin]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-node@v6
        with:
          node-version: 24
          cache: 'npm'
      - run: npm ci
      # 管理画面の配信単位を組み立てる: admin/ の「中身」を deploy root へ展開 + functions/ + workers/ (functions が import)。
      # admin バンドルの index.html は asset を /assets/* (ルート絶対) で参照するため、admin/ をサブdir配置せず root 展開する。
      # ルーティングは admin/ 同梱の _redirects (/* /index.html 200) と _routes.json (/api/*) を使う。
      # content 配信用の root _redirects (/* → /public/:splat) / _routes.json は同梱しない（/assets/* を 404 に吸い込むため）。
      # node_modules・public/・frelio-data/ は含めない。functions→workers の相対 import 位置は保持される。
      - name: Assemble admin deploy directory
        run: |
          rm -rf .admin-deploy
          mkdir -p .admin-deploy
          cp -r admin/. .admin-deploy/
          cp -r functions workers .admin-deploy/
      - name: Deploy to Cloudflare Pages
        uses: cloudflare/wrangler-action@v4
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          command: pages deploy .admin-deploy --project-name={{adminPagesProjectName}}
