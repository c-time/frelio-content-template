# CMS の「直接デプロイ」ボタンから workflow_dispatch で発火。
# 実処理は再利用可能ワークフロー _deploy.yml に委譲する（予約反映と共通）。
name: Direct Deploy
on:
  workflow_dispatch:
    inputs:
      full_rebuild:
        description: 'Full rebuild (skip cache, regenerate all)'
        required: false
        default: 'false'
        type: choice
        options: ['false', 'true']

permissions:
  contents: write

jobs:
  deploy:
    uses: ./.github/workflows/_deploy.yml
    with:
      full_rebuild: ${{ inputs.full_rebuild }}
    secrets: inherit
