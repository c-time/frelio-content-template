{
  "version": "1.0",
  "outputTimezone": "+09:00",
  "contentTypes": {
    "article": {
      "details": [
        {
          "type": "detail",
          "outputPath": "news/{$this.slug}/index.json",
          "templatePath": "news/_detail/index.html",
          "customFields": [
            { "field": "publishDate", "source": "{$this.publishDate}", "type": "date", "format": "YYYY-MM-DD" },
            { "field": "eyecatchSrc", "source": "/storage/{$this.eyecatch.url}", "type": "string" }
          ],
          "navigation": {
            "sort": [{ "field": "publishDate", "direction": "desc" }],
            "fields": ["slug", "title"]
          }
        }
      ],
      "lists": [
        {
          "type": "list",
          "outputPath": "news/index.json",
          "templatePath": "news/index.html",
          "sort": [{ "field": "publishDate", "direction": "desc" }],
          "pagination": { "perPage": 10, "numberFormatCount": 1 },
          "customFields": [
            { "field": "publishDate", "source": "{$this.publishDate}", "type": "date", "format": "YYYY-MM-DD" },
            { "field": "href", "source": "/news/{$this.slug}/", "type": "string" }
          ]
        }
      ]
    },
    "faq": {
      "lists": [
        {
          "type": "list",
          "outputPath": "faq/index.json",
          "templatePath": "faq/index.html",
          "sort": [
            { "field": "category", "direction": "asc" },
            { "field": "sortOrder", "direction": "asc" }
          ]
        }
      ]
    }
  },
  "staticPages": [
    {
      "type": "static",
      "outputPath": "index.json",
      "templatePath": "index.html",
      "customFields": [
        {
          "field": "latestNews",
          "type": "relationList",
          "contentTypeId": "article",
          "limit": 5,
          "sort": { "field": "publishDate", "direction": "desc" },
          "listFields": ["slug", "title", "excerpt", "eyecatch", "publishDate"],
          "customFields": [
            { "field": "publishDate", "source": "{$this.publishDate}", "type": "date", "format": "YYYY-MM-DD" },
            { "field": "href", "source": "/news/{$this.slug}/", "type": "string" }
          ]
        }
      ]
    },
    { "type": "static", "outputPath": "about/index.json", "templatePath": "about/index.html" },
    { "type": "static", "outputPath": "contact/index.json", "templatePath": "contact/index.html" },
    { "type": "static", "outputPath": "404.json", "templatePath": "404.html" }
  ],
  "templateIncludes": {
    "_parts/*.htm": ["*"]
  },
  "lastUpdatedAt": "2026-01-01T00:00:00.000Z",
  "lastUpdatedBy": "frelio-cli"
}
