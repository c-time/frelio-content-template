# Cloudflare Pages 設定（コンテンツ配信・管理画面デプロイで共用 / Issue #23）
# pages_build_output_dir を指定することで wrangler pages deploy が本ファイルを
# 読み込み、R2 バインディングと環境変数をデプロイ時に自動適用する。
# デプロイ先ディレクトリ・project 名はコマンドライン引数が優先される。
name = "{{pagesProjectName}}"
pages_build_output_dir = "public"
compatibility_date = "2024-01-01"

[[r2_buckets]]
binding = "R2"
bucket_name = "{{r2BucketName}}"

# 環境変数（管理画面 functions/api が参照。コンテンツ配信側では未使用）
[vars]
R2_PUBLIC_URL = "{{r2PublicUrl}}"
ALLOWED_ORIGINS = "{{allowedOrigins}}"
CONTENT_REPO = "{{contentRepo}}"
# 管理画面 OAuth の公開クライアントID（admin/config.json の githubClientId と同値）。
# wrangler pages deploy は [vars] で plain env を置換するため、ここに置かないと
# 毎デプロイで admin プロジェクトから消え、管理画面ログインが 500 になる（Issue #137）。
GITHUB_CLIENT_ID = "{{githubClientId}}"
# デプロイ管理機能（Issue #27）: functions/api/deployments が Cloudflare Pages API を呼ぶのに使用。
# CLOUDFLARE_API_TOKEN はシークレットのため wrangler pages secret で管理画面プロジェクトに設定する（ここには置かない）。
CLOUDFLARE_ACCOUNT_ID = "{{cloudflareAccountId}}"
PAGES_PROJECT_NAME = "{{pagesProjectName}}"
# 本番ゲート（Issue #93）: コンテンツ配信の functions/_middleware.ts がエッジで参照する。
# SITE_MODE: live | prelaunch | maintenance | closed。
# CANONICAL_HOST / CONTENT_PAGES_DEV は派生値（productionUrl ホスト / <project>.pages.dev）。
SITE_MODE = "{{siteMode}}"
CANONICAL_HOST = "{{canonicalHost}}"
CONTENT_PAGES_DEV = "{{contentPagesDev}}"
