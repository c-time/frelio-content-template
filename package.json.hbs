{
  "name": "{{contentWorkerName}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "wrangler dev --config wrangler.admin.toml --port 5173",
    "build": "tsx scripts/copy-static-assets.ts && vite build",
    "preview": "vite preview",
    "copy:static": "tsx scripts/copy-static-assets.ts",
    "generate:dep-map": "tsx scripts/generate-dependency-map.ts",
    "generate": "tsx scripts/generate-data-json.ts",
    "generate:full": "tsx scripts/generate-data-json.ts --full-rebuild",
    "generate:dry-run": "tsx scripts/generate-data-json.ts --dry-run",
    "generate:html": "tsx scripts/generate-html.ts",
    "generate:html:dry-run": "tsx scripts/generate-html.ts --dry-run",
    "bake": "tsx scripts/bake-templates.ts",
    "bake:dry-run": "tsx scripts/bake-templates.ts --dry-run",
    "bake:check": "tsx scripts/bake-templates.ts --check",
    "validate:content": "tsx scripts/validate-content.ts",
    "check": "npm run generate && npm run bake:check && npm run validate:content",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "generate:sitemap:full": "tsx scripts/generate-sitemap.ts --full-rebuild",
    "watch:content": "tsx scripts/watch-content.ts",
    "rebuild:indexes": "tsx scripts/rebuild-indexes.ts",
    "rebuild:indexes:dry-run": "tsx scripts/rebuild-indexes.ts --dry-run",
    "schedule:process": "tsx scripts/process-schedule.ts",
    "schedule:process:dry-run": "tsx scripts/process-schedule.ts --dry-run"
  },
  "devDependencies": {
    "@c-time/frelio-content-ops": "*",
    "@c-time/frelio-data-json-generator": "*",
    "@c-time/frelio-data-json-recipe": "*",
    "@c-time/frelio-data-json-recipe-to-dependency-map": "*",
    "@c-time/frelio-dependency-map": "*",
    "@c-time/frelio-gentl": "*",
    "@c-time/frelio-types": "*",
    "sass": "^1.80.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.40.0",
    "zod": "^3.25.0"
  }
}
