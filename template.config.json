{
  "version": "1.0.0",
  "description": "Frelio content repository template - Japanese corporate site with news blog",
  "variables": [
    { "name": "contentRepo", "required": true, "description": "GitHub リポジトリ (owner/repo)" },
    { "name": "githubClientId", "required": false, "default": "" },
    { "name": "siteTitle", "required": false, "default": "" },
    { "name": "productionUrl", "required": false, "default": "" },
    { "name": "previewUrl", "required": false, "default": "" },
    { "name": "fileUploadUrl", "required": false, "default": "/api/storage" },
    { "name": "contentWorkerName", "required": true },
    { "name": "adminWorkerName", "required": true },
    { "name": "r2BucketName", "required": true },
    { "name": "r2PublicUrl", "required": false, "default": "" },
    { "name": "imagePublicUrl", "required": false, "default": "", "description": "画像の R2 カスタムドメイン配信ベース URL（任意・issue #278）。設定の有無が独自ドメイン配信の opt-in を兼ねる" },
    { "name": "ownerUsername", "required": true },
    { "name": "saveTimezone", "required": false, "default": "+09:00", "description": "保存タイムゾーン（ISO 8601 オフセット表記、例 +09:00）。日時の保存に使用（issue #92）" }
  ]
}
