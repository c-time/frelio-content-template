{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": [
    "frelio-data/site/templates/**/*.ts",
    "vite.config.ts",
    "vite-plugins/**/*.ts"
  ]
}
